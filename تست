local function sendMessageNow()
    if ChatInput.Text ~= "" then
        local msg = ChatInput.Text
        ChatInput.Text = ""
        
        local muteData = nil
        pcall(function()
            local res = customRequest({Url = FIREBASE_ADMIN_ACTIONS_URL, Method = "GET"})
            if res and res.StatusCode == 200 then
                local data = safeDecode(res.Body)
                if data and data.mutes then
                    muteData = data.mutes[tostring(LocalPlayer.UserId)]
                end
            end
        end)

        if muteData then
            addChatMessage("⚠️ تنبيه الكتم", "أنت مكتوم حالياً من شات السكربت لمدة (" .. tostring(muteData.duration or "غير محددة") .. ")", LocalPlayer.UserId, "mute_alert")
            return
        end

        pcall(function()
            customRequest({
                Url = FIREBASE_CHAT_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({
                    sender = LocalPlayer.DisplayName ~= "" and LocalPlayer.DisplayName or LocalPlayer.Name,
                    userId = LocalPlayer.UserId,
                    text = msg,
                    time = os.time()
                })
            })
        end)
    end
end


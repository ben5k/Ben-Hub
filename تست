    local function addToggleRow(nameText, onToggle)
        local rowFrame = Instance.new("Frame")
        rowFrame.Size = UDim2.new(1, 0, 0, 36)
        rowFrame.BackgroundColor3 = Color3.fromRGB(22, 16, 36)
        rowFrame.ZIndex = 3
        rowFrame.Parent = contentHolder
        Instance.new("UICorner", rowFrame).CornerRadius = UDim.new(0, 6)

        local rowStroke = Instance.new("UIStroke")
        rowStroke.Color = currentAccentColor
        rowStroke.Thickness = 1.2
        rowStroke.Parent = rowFrame
        table.insert(registeredOptionStrokes, rowStroke)

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size = UDim2.new(1, -50, 1, 0)
        nameLbl.Position = UDim2.new(0, 10, 0, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = nameText
        nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLbl.Font = Enum.Font.FredokaOne
        nameLbl.TextSize = 14
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.ZIndex = 4
        nameLbl.Parent = rowFrame

        local toggleBtn = Instance.new("TextButton")
        toggleBtn.Size = UDim2.new(0, 22, 0, 22)
        toggleBtn.Position = UDim2.new(1, -32, 0.5, -11)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
        toggleBtn.Text = ""
        toggleBtn.ZIndex = 4
        toggleBtn.Parent = rowFrame
        Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 4)

        local innerBox = Instance.new("Frame")
        innerBox.Size = UDim2.new(1, -6, 1, -6)
        innerBox.Position = UDim2.new(0, 3, 0, 3)
        innerBox.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        innerBox.Visible = false
        innerBox.ZIndex = 5
        innerBox.Parent = toggleBtn
        Instance.new("UICorner", innerBox).CornerRadius = UDim.new(0, 2)

        local state = false
        toggleBtn.MouseButton1Click:Connect(function()
            playUiSound(SOUND_CLICK, 1, 0.35)
            state = not state
            innerBox.Visible = state
            if onToggle then onToggle(state) end
        end)
    end

    local function addActionRow(nameText, onClick)
        local rowFrame = Instance.new("Frame")
        rowFrame.Size = UDim2.new(1, 0, 0, 34)
        rowFrame.BackgroundColor3 = Color3.fromRGB(22, 16, 36)
        rowFrame.ZIndex = 3
        rowFrame.Parent = contentHolder
        Instance.new("UICorner", rowFrame).CornerRadius = UDim.new(0, 6)

        local rowStroke = Instance.new("UIStroke")
        rowStroke.Color = currentAccentColor
        rowStroke.Thickness = 1.2
        rowStroke.Parent = rowFrame
        table.insert(registeredOptionStrokes, rowStroke)

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 1, 0)
        btn.BackgroundTransparency = 1
        btn.Text = nameText
        btn.TextColor3 = Color3.fromRGB(240, 240, 255)
        btn.Font = Enum.Font.FredokaOne
        btn.TextSize = 14
        btn.TextXAlignment = Enum.TextXAlignment.Center
        btn.ZIndex = 4
        btn.Parent = rowFrame

        btn.MouseButton1Click:Connect(function()
            playUiSound(SOUND_CLICK, 1, 0.35)
            if onClick then onClick() end
        end)
    end

    builderFunc(addToggleRow, addActionRow, contentHolder)

    headBtn.MouseButton1Click:Connect(function()
        playUiSound(SOUND_CLICK, 1, 0.35)
        isOpen = not isOpen
        headBtn.Text = (isOpen and "  ˅  " or "  >  ") .. titleText
        contentHolder.Visible = isOpen

        if isOpen then
            task.wait(0.02)
            local totalHeight = contentLayout.AbsoluteContentSize.Y + 15
            contentHolder.Size = UDim2.new(1, 0, 0, totalHeight)
            folderFrame.Size = UDim2.new(1, 0, 0, totalHeight + 40)
        else
            folderFrame.Size = UDim2.new(1, 0, 0, 36)
        end

        task.wait(0.05)
        CenterScroll.CanvasSize = UDim2.new(0, 0, 0, CenterLayout.AbsoluteContentSize.Y + 25)
    end)
end

local function clearCenter()
    for _, child in ipairs(CenterScroll:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end
end


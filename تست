local function addChilliAccordion(titleText, builderFunc)
    local folderFrame = Instance.new("Frame")
    folderFrame.Size = UDim2.new(1, 0, 0, 36)
    folderFrame.BackgroundTransparency = 1
    folderFrame.ZIndex = 3
    folderFrame.Parent = CenterScroll

    local headBtn = Instance.new("TextButton")
    headBtn.Size = UDim2.new(1, 0, 0, 36)
    headBtn.BackgroundTransparency = 1
    headBtn.Text = "  >  " .. titleText
    headBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    headBtn.Font = Enum.Font.FredokaOne
    headBtn.TextSize = 17
    headBtn.TextXAlignment = Enum.TextXAlignment.Center
    headBtn.ZIndex = 3
    headBtn.Parent = folderFrame

    local contentHolder = Instance.new("Frame")
    contentHolder.Size = UDim2.new(1, 0, 0, 0)
    contentHolder.Position = UDim2.new(0, 0, 0, 38)
    contentHolder.BackgroundTransparency = 1
    contentHolder.Visible = false
    contentHolder.ZIndex = 3
    contentHolder.Parent = folderFrame

    local contentLayout = Instance.new("UIListLayout")
    contentLayout.Padding = UDim.new(0, 6)
    contentLayout.Parent = contentHolder

    local isOpen = false
    builderFunc(contentHolder)

    headBtn.MouseButton1Click:Connect(function()
        playUiSound("rbxassetid://6895079853", 1, 0.25)
        isOpen = not isOpen
        headBtn.Text = (isOpen and "  ˅  " or "  >  ") .. titleText
        contentHolder.Visible = isOpen

        if isOpen then
            task.wait(0.02)
            local totalHeight = contentLayout.AbsoluteContentSize.Y + 15
            contentHolder.Size = UDim2.new(1, 0, 0, totalHeight)
            folderFrame.Size = UDim2.new(1, 0, 0, totalHeight + 40)
        else
            folderFrame.Size = UDim2.new(1, 0, 0, 36)
        end
        CenterScroll.CanvasSize = UDim2.new(0, 0, 0, CenterLayout.AbsoluteContentSize.Y + 25)
    end)
end

local function clearCenter()
    for _, child in ipairs(CenterScroll:GetChildren()) do
        if not child:IsA("UIListLayout") then child:Destroy() end
    end
end


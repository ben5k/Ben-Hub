local tabs = {}
local allRows = {}
local currentTab

local function selectTab(name)
    currentTab = name
    for n, t in pairs(tabs) do
        local active = (n == name)
        t.page.Visible = active
        TweenService:Create(t.button, TweenInfo.new(0.15), {
            BackgroundColor3 = active and C.Red or C.Row,
        }):Play()
    end
end

local function createTab(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = C.Row
    btn.Text = name
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.TextColor3 = C.Text
    btn.AutoButtonColor = false
    btn.Parent = sidebar
    corner(btn, 8)

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, -12, 1, -12)
    page.Position = UDim2.new(0, 6, 0, 6)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 4
    page.ScrollBarImageColor3 = C.Red
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.Parent = content

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.Parent = page

    tabs[name] = { page = page, button = btn }
    btn.MouseButton1Click:Connect(function()
        searchBox.Text = ""
        selectTab(name)
    end)
    return page
end

local function createRow(page, labelText)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 40)
    row.BackgroundColor3 = C.Row
    row.BorderSizePixel = 0
    row.Parent = page
    corner(row, 8)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -130, 1, 0)
    lbl.Position = UDim2.new(0, 120, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 14
    lbl.TextColor3 = C.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Right
    lbl.Parent = row

    table.insert(allRows, { row = row, text = labelText, page = page })
    return row
end

local function addButton(page, labelText, btnText, callback)
    local row = createRow(page, labelText)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 100, 0, 28)
    b.Position = UDim2.new(0, 8, 0.5, -14)
    b.BackgroundColor3 = C.Red
    b.Text = btnText
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.TextColor3 = C.Text
    b.Parent = row
    corner(b, 6)
    b.MouseButton1Click:Connect(function()
        task.spawn(callback)
    end)
    return b
end

local function addToggle(page, labelText, default, callback)
    local row = createRow(page, labelText)
    local state = default or false

    local bg = Instance.new("TextButton")
    bg.Size = UDim2.new(0, 52, 0, 26)
    bg.Position = UDim2.new(0, 8, 0.5, -13)
    bg.Text = ""
    bg.AutoButtonColor = false
    bg.BackgroundColor3 = state and C.Green or C.DarkRed
    bg.Parent = row
    corner(bg, 13)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 20, 0, 20)
    knob.Position = state and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
    knob.BackgroundColor3 = C.Text
    knob.Parent = bg
    corner(knob, 10)

    local function render()
        TweenService:Create(bg, TweenInfo.new(0.15), {
            BackgroundColor3 = state and C.Green or C.DarkRed,
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = state and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10),
        }):Play()
    end

    bg.MouseButton1Click:Connect(function()
        state = not state
        render()
        task.spawn(callback, state)
    end)

    if state then task.spawn(callback, state) end
end

local function addTextBox(page, labelText, placeholder)
    local row = createRow(page, labelText)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 150, 0, 28)
    box.Position = UDim2.new(0, 8, 0.5, -14)
    box.BackgroundColor3 = C.BG
    box.Text = ""
    box.PlaceholderText = placeholder
    box.PlaceholderColor3 = C.SubText
    box.TextColor3 = C.Text
    box.Font = Enum.Font.Gotham
    box.TextSize = 12
    box.ClearTextOnFocus = false
    box.Parent = row
    corner(box, 6)
    stroke(box, C.DarkRed, 1)
    local lbl = row:FindFirstChildOfClass("TextLabel")
    lbl.Size = UDim2.new(1, -175, 1, 0)
    lbl.Position = UDim2.new(0, 165, 0, 0)
    return box
end

local function addDropdown(page, labelText, options, default, callback)
    local row = createRow(page, labelText)
    local idx = table.find(options, default) or 1
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 130, 0, 28)
    b.Position = UDim2.new(0, 8, 0.5, -14)
    b.BackgroundColor3 = C.BG
    b.Text = options[idx] .. "  ✔"
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.TextColor3 = C.Text
    b.Parent = row
    corner(b, 6)
    stroke(b, C.Red, 1)
    local lbl = row:FindFirstChildOfClass("TextLabel")
    lbl.Size = UDim2.new(1, -155, 1, 0)
    lbl.Position = UDim2.new(0, 145, 0, 0)
    b.MouseButton1Click:Connect(function()
        idx = idx % #options + 1
        b.Text = options[idx] .. "  ✔"
        callback(options[idx])
    end)
    callback(options[idx])
end

-- ====== البحث ======
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local q = searchBox.Text
    if q == "" then
        for _, r in ipairs(allRows) do r.row.Visible = true end
        if currentTab then selectTab(currentTab) end
        return
    end
    for _, t in pairs(tabs) do t.page.Visible = true end
    for _, r in ipairs(allRows) do
        r.row.Visible = r.text:find(q, 1, true) ~= nil
    end
end)


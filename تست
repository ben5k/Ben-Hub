end

local function fetchAudioFile(url, fileName)
    if writefile and getcustomasset and readfile then
        local file = "DFXMusic_" .. fileName .. ".mp3"
        local success = pcall(function()
            if not isfile(file) then
                local data = game:HttpGet(url)
                writefile(file, data)
            end
        end)
        if success and isfile(file) then
            local assetPath = getcustomasset(file)
            if assetPath then return assetPath end
        end
    end
    return url
end


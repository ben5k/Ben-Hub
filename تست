local function sideButtons(name, labels, side)
    local frame = make("Frame", {
        Name = name,
        AnchorPoint = side == "Right"
            and Vector2.new(0, 0.5)
            or Vector2.new(1, 0.5),
        Position = side == "Right"
            and UDim2.new(1, -8, 0.5, 0)
            or UDim2.new(0, 8, 0.5, 0),
        Size = UDim2.new(0, 112, 0, 270),
        BackgroundTransparency = 1
    }, gui)

    make("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, frame)

    for i, label in ipairs(labels) do
        local b = make("TextButton", {
            LayoutOrder = i,
            Size = UDim2.new(1, 0, 0, 47),
            BackgroundColor3 = red,
            BorderSizePixel = 0,
            Text = label,
            TextColor3 = white,
            TextSize = 16,
            TextWrapped = true,
            Font = Enum.Font.GothamBold,
            AutoButtonColor = true
        }, frame)
        corner(b, 4)
        gradient(b, Color3.fromRGB(255, 100, 77), redDark)
        stroke(b, Color3.fromRGB(70, 30, 25), 1)

        b.MouseButton1Click:Connect(function()
            notify(label .. " - visual demo")
        end)
    end
end


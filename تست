task.spawn(function()
    local timer = 300
    while true do
        task.wait(1)
        timer = timer - 1
        local mins = math.floor(timer / 60)
        local secs = timer % 60
        ResetTimerLbl.Text = string.format("⏱️ التصفير التلقائي: %02d:%02d", mins, secs)

        local currentTime = os.time()
        pcall(function()
            local res = customRequest({Url = FIREBASE_CHAT_URL, Method = "GET"})
            if res and res.StatusCode == 200 then
                local data = safeDecode(res.Body)
                if data then
                    for k, m in pairs(data) do
                        if type(m) == "table" and m.time and (currentTime - m.time) >= 300 then
                            customRequest({Url = FIREBASE_BASE_URL .. "/global_chat/" .. k .. ".json", Method = "DELETE"})
                            if ChatScroll:FindFirstChild(k) then ChatScroll[k]:Destroy() end
                            renderedMsgs[k] = nil
                        end
                    end
                end
            end
        end)

        if timer <= 0 then
            timer = 300
            for _, child in ipairs(ChatScroll:GetChildren()) do
                if not child:IsA("UIListLayout") then child:Destroy() end
            end
            renderedMsgs = {}
        end
    end
end)


task.spawn(function()
    while true do
        pcall(function()
            local res = customRequest({Url = FIREBASE_CHAT_URL, Method = "GET"})
            if res and res.StatusCode == 200 then
                local data = safeDecode(res.Body)
                if data then
                    for k, m in pairs(data) do
                        if type(m) == "table" and m.text and not renderedMsgs[k] then
                            renderedMsgs[k] = true
                            addChatMessage(tostring(m.sender or "مجهول"), tostring(m.text or ""), tonumber(m.userId))
                        end
                    end
                end
            end
        end)
        task.wait(2.5)
    end
end)


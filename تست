local function applyOverheadTag(plr)
    if not plr.Character then return end
    local head = plr.Character:WaitForChild("Head", 5)
    if not head then return end

    if head:FindFirstChild("DFXOverheadTag") then head.DFXOverheadTag:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name = "DFXOverheadTag"
    bb.Size = UDim2.new(0, 200, 0, 45)
    bb.StudsOffset = Vector3.new(0, 2.8, 0)
    bb.AlwaysOnTop = true
    bb.Parent = head

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.FredokaOne
    lbl.TextSize = 16
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Parent = bb

    if plr.Name == "Dms921" then
        lbl.Text = "👑المطور طحبح👑"
        lbl.TextColor3 = Color3.fromRGB(255, 215, 0)
    else
        lbl.Text = plr.Name .. " ⭐"
        lbl.TextColor3 = Color3.fromRGB(0, 230, 255)
    end

    local textStroke = Instance.new("UIStroke")
    textStroke.Color = Color3.fromRGB(0, 0, 0)
    textStroke.Thickness = 2
    textStroke.Parent = lbl
end

local function setupAllTags()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then applyOverheadTag(p) end
        p.CharacterAdded:Connect(function() task.wait(1); applyOverheadTag(p) end)
    end
    Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function() task.wait(1); applyOverheadTag(p) end)
    end)
end

setupAllTags()


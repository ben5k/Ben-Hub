local function sendMessageNow()
    if ChatInput.Text ~= "" then
        local msg = ChatInput.Text
        ChatInput.Text = ""
        
        local muteData = nil
        pcall(function()
            local res = customRequest({Url = FIREBASE_ADMIN_ACTIONS_URL .. "/mutes/" .. tostring(LocalPlayer.UserId) .. ".json", Method = "GET"})
            if res and res.StatusCode == 200 then
                muteData = safeDecode(res.Body)
            end
        end)

        if muteData and muteData.endTime and os.time() < muteData.endTime then
            local remain = muteData.endTime - os.time()
            local mins = math.floor(remain / 60)
            local secs = remain % 60
            local timeStr = string.format("%02d:%02d", mins, secs)
            
            addChatMessage("👑 طحبح (تنبيه الكتم)", "أنت مكتوم بواسطة طحبح حتى (" .. timeStr .. ")\nالسبب: " .. tostring(muteData.reason or "بدون سبب"), 921, "muted_msg")
            return
        end

        pcall(function()
            customRequest({
                Url = FIREBASE_CHAT_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({
                    sender = LocalPlayer.DisplayName ~= "" and LocalPlayer.DisplayName or LocalPlayer.Name,
                    userId = LocalPlayer.UserId,
                    text = msg,
                    time = os.time()
                })
            })
        end)
    end
end


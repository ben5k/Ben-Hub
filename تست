local function addAccordionSection(titleText, builderFunc)
    local sectionFrame = Instance.new("Frame")
    sectionFrame.Size = UDim2.new(1, 0, 0, 26)
    sectionFrame.BackgroundTransparency = 1
    sectionFrame.ZIndex = 2
    sectionFrame.Parent = CenterScroll

    local headBtn = Instance.new("TextButton")
    headBtn.Size = UDim2.new(1, 0, 0, 26)
    headBtn.BackgroundTransparency = 1
    headBtn.Text = "  ◀  " .. titleText
    headBtn.TextColor3 = Color3.fromRGB(235, 210, 255)
    headBtn.Font = Enum.Font.SourceSansBold
    headBtn.TextSize = 15
    headBtn.TextXAlignment = Enum.TextXAlignment.Right
    headBtn.ZIndex = 2
    headBtn.Parent = sectionFrame

    local contentHolder = Instance.new("Frame")
    contentHolder.Size = UDim2.new(1, 0, 0, 0)
    contentHolder.Position = UDim2.new(0, 0, 0, 26)
    contentHolder.BackgroundTransparency = 1
    contentHolder.Visible = false
    contentHolder.ZIndex = 2
    contentHolder.Parent = sectionFrame

    local contentLayout = Instance.new("UIListLayout")
    contentLayout.Padding = UDim.new(0, 4)
    contentLayout.Parent = contentHolder

    local isOpen = false

    local function addToggleRow(nameText, descText, defaultState, onToggle)
        local rowFrame = Instance.new("Frame")
        rowFrame.Size = UDim2.new(1, 0, 0, descText ~= "" and 40 or 26)
        rowFrame.BackgroundColor3 = Color3.fromRGB(25, 15, 45)
        rowFrame.BackgroundTransparency = 0.4
        rowFrame.BorderSizePixel = 0
        rowFrame.ZIndex = 2
        rowFrame.Parent = contentHolder
        Instance.new("UICorner", rowFrame).CornerRadius = UDim.new(0, 4)

        local rowStroke = Instance.new("UIStroke")
        rowStroke.Color = Color3.fromRGB(110, 40, 190)
        rowStroke.Thickness = 1
        rowStroke.Parent = rowFrame

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size = UDim2.new(1, -48, 0, 18)
        nameLbl.Position = UDim2.new(0, 5, 0, 2)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = nameText
        nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLbl.Font = Enum.Font.SourceSansBold
        nameLbl.TextSize = 13.5
        nameLbl.TextXAlignment = Enum.TextXAlignment.Right
        nameLbl.ZIndex = 3
        nameLbl.Parent = rowFrame

        if descText ~= "" then
            local descLbl = Instance.new("TextLabel")
            descLbl.Size = UDim2.new(1, -48, 0, 16)
            descLbl.Position = UDim2.new(0, 5, 0, 20)
            descLbl.BackgroundTransparency = 1
            descLbl.Text = descText
            descLbl.TextColor3 = Color3.fromRGB(180, 160, 220)
            descLbl.Font = Enum.Font.SourceSans
            descLbl.TextSize = 10.5
            descLbl.TextXAlignment = Enum.TextXAlignment.Right
            descLbl.ZIndex = 3
            descLbl.Parent = rowFrame
        end

        local toggleBtn = Instance.new("TextButton")
        toggleBtn.Size = UDim2.new(0, 34, 0, 18)
        toggleBtn.Position = UDim2.new(0, 6, 0.5, -9)
        toggleBtn.BackgroundColor3 = defaultState and Color3.fromRGB(140, 40, 255) or Color3.fromRGB(50, 30, 80)
        toggleBtn.Text = ""
        toggleBtn.ZIndex = 3
        toggleBtn.Parent = rowFrame
        Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 4)

        local innerBox = Instance.new("Frame")
        innerBox.Size = UDim2.new(0, 12, 0, 14)
        innerBox.Position = defaultState and UDim2.new(1, -14, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        innerBox.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        innerBox.ZIndex = 4
        innerBox.Parent = toggleBtn
        Instance.new("UICorner", innerBox).CornerRadius = UDim.new(0, 3)

        local state = defaultState
        toggleBtn.MouseButton1Click:Connect(function()
            playUiSound(SOUND_CLICK, 1)
            state = not state
            toggleBtn.BackgroundColor3 = state and currentAccentColor or Color3.fromRGB(50, 30, 80)
            innerBox.Position = state and UDim2.new(1, -14, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
            if onToggle then onToggle(state) end
        end)
    end

    local function addActionRow(nameText, onClick)
        local rowFrame = Instance.new("Frame")
        rowFrame.Size = UDim2.new(1, 0, 0, 26)
        rowFrame.BackgroundColor3 = Color3.fromRGB(25, 15, 45)
        rowFrame.BackgroundTransparency = 0.4
        rowFrame.BorderSizePixel = 0
        rowFrame.ZIndex = 2
        rowFrame.Parent = contentHolder
        Instance.new("UICorner", rowFrame).CornerRadius = UDim.new(0, 4)

        local rowStroke = Instance.new("UIStroke")
        rowStroke.Color = Color3.fromRGB(110, 40, 190)
        rowStroke.Thickness = 1
        rowStroke.Parent = rowFrame

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 1, 0)
        btn.Position = UDim2.new(0, 5, 0, 0)
        btn.BackgroundTransparency = 1
        btn.Text = "◀  " .. nameText
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.SourceSansBold
        btn.TextSize = 13.5
        btn.TextXAlignment = Enum.TextXAlignment.Right
        btn.ZIndex = 3
        btn.Parent = rowFrame

        btn.MouseButton1Click:Connect(function()
            playUiSound(SOUND_CLICK, 1)
            if onClick then onClick() end
        end)
    end

    builderFunc(addToggleRow, addActionRow)

    headBtn.MouseButton1Click:Connect(function()
        playUiSound(SOUND_CLICK, 1)
        isOpen = not isOpen
        headBtn.Text = (isOpen and "  ▼  " or "  ◀  ") .. titleText
        contentHolder.Visible = isOpen
        
        if isOpen then
            local totalHeight = contentLayout.AbsoluteContentSize.Y
            contentHolder.Size = UDim2.new(1, 0, 0, totalHeight)
            sectionFrame.Size = UDim2.new(1, 0, 0, totalHeight + 28)
        else
            sectionFrame.Size = UDim2.new(1, 0, 0, 26)
        end
        
        task.wait(0.05)
        CenterScroll.CanvasSize = UDim2.new(0, 0, 0, CenterLayout.AbsoluteContentSize.Y + 15)
    end)
end

local function clearCenter()
    for _, child in ipairs(CenterScroll:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end
end


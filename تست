local function customRequest(options)
    local req = request or http_request or (syn and syn.request) or (http and http.request) or (fluxus and fluxus.request)
    if req then
        local success, response = pcall(function() return req(options) end)
        if success and response then return response end
    end
    if options.Method == "GET" then
        local success, body = pcall(function() return game:HttpGet(options.Url) end)
        if success then return {StatusCode = 200, Body = body} end
    end
    return {StatusCode = 400, Body = "null"}
end

local function safeDecode(jsonStr)
    if not jsonStr or jsonStr == "" or jsonStr == "null" then return nil end
    local success, result = pcall(function() return HttpService:JSONDecode(jsonStr) end)
    if success then return result end
    return nil
end

local function fetchAsset(url, fileName)

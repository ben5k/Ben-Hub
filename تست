local function addSection(title, items)
    local heading = create("Frame", {
        Size = UDim2.new(1, -4, 0, 40),
        BackgroundColor3 = Color3.fromRGB(62, 43, 38),
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0
    }, body)

    label(
        heading,
        "‹  " .. title,
        UDim2.new(1, -12, 1, 0),
        UDim2.new(0, 5, 0, 0),
        16
    )

    for _, item in ipairs(items) do
        local row = create("Frame", {
            Size = UDim2.new(1, -4, 0, 40),
            BackgroundColor3 = dark,
            BackgroundTransparency = 0.12,
            BorderSizePixel = 0
        }, body)

        outline(row, Color3.fromRGB(18, 20, 18), 1)

        label(
            row,
            item,
            UDim2.new(1, -20, 1, 0),
            UDim2.new(0, 10, 0, 0),
            14
        )

        -- مربع ثابت للزينة فقط، ليس زرًا
        local square = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 23, 0.5, 0),
            Size = UDim2.new(0, 20, 0, 20),
            BackgroundColor3 = Color3.fromRGB(232, 235, 232),
            BorderSizePixel = 0
        }, row)

        outline(square, Color3.fromRGB(75,75,75), 1)
    end
end


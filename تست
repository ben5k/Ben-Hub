local function applyScriptBackground(idx, skipSave)
    selectedScriptBgIndex = idx
    if idx > 0 and wallUrls[idx] then
        BgImage.Image = wallUrls[idx]
        BgImage.Visible = true
        CenterBox.BackgroundTransparency = 0.85
    else
        BgImage.Visible = false
        CenterBox.BackgroundTransparency = 0
    end
    if not skipSave then
        pcall(function()
            if writefile then
                local cfg = {
                    accentR = currentAccentColor.R, accentG = currentAccentColor.G, accentB = currentAccentColor.B,
                    headR = currentHeaderColor.R, headG = currentHeaderColor.G, headB = currentHeaderColor.B,
                    scriptBgIndex = selectedScriptBgIndex, chatBgIndex = selectedChatBgIndex, neonSpd = neonSpeed
                }
                writefile(CONFIG_FILE, HttpService:JSONEncode(cfg))
            end
        end)
    end
end

local function applyChatBackground(idx, skipSave)
    selectedChatBgIndex = idx
    if idx > 0 and wallUrls[idx] then
        ChatBgImage.Image = wallUrls[idx]
        ChatBgImage.Visible = true
        ChatWin.BackgroundTransparency = 0.85
    else
        ChatBgImage.Visible = false
        ChatWin.BackgroundTransparency = 0
    end
    if not skipSave then
        pcall(function()
            if writefile then
                local cfg = {
                    accentR = currentAccentColor.R, accentG = currentAccentColor.G, accentB = currentAccentColor.B,
                    headR = currentHeaderColor.R, headG = currentHeaderColor.G, headB = currentHeaderColor.B,
                    scriptBgIndex = selectedScriptBgIndex, chatBgIndex = selectedChatBgIndex, neonSpd = neonSpeed
                }
                writefile(CONFIG_FILE, HttpService:JSONEncode(cfg))
            end
        end)
    end
end


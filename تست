-- إضافة قسم قابل للفتح والإغلاق (Accordion Section)
local function addAccordionSection(titleText, builderFunc)
    local sectionFrame = Instance.new("Frame")
    sectionFrame.Size = UDim2.new(1, 0, 0, 26)
    sectionFrame.BackgroundTransparency = 1
    sectionFrame.Parent = CenterScroll

    local headBtn = Instance.new("TextButton")
    headBtn.Size = UDim2.new(1, 0, 0, 26)
    headBtn.BackgroundTransparency = 1
    headBtn.Text = "  >  " .. titleText
    headBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    headBtn.Font = Enum.Font.SourceSansBold
    headBtn.TextSize = 16
    headBtn.TextXAlignment = Enum.TextXAlignment.Left
    headBtn.Parent = sectionFrame

    local contentHolder = Instance.new("Frame")
    contentHolder.Size = UDim2.new(1, 0, 0, 0)
    contentHolder.Position = UDim2.new(0, 0, 0, 26)
    contentHolder.BackgroundTransparency = 1
    contentHolder.Visible = false
    contentHolder.Parent = sectionFrame

    local contentLayout = Instance.new("UIListLayout")
    contentLayout.Padding = UDim.new(0, 4)
    contentLayout.Parent = contentHolder

    local isOpen = false

    local function addToggleItem(nameText, descText, defaultState, onToggle)
        local itemFrame = Instance.new("Frame")
        itemFrame.Size = UDim2.new(1, 0, 0, descText ~= "" and 40 or 26)
        itemFrame.BackgroundTransparency = 1
        itemFrame.Parent = contentHolder

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size = UDim2.new(1, -45, 0, 18)
        nameLbl.Position = UDim2.new(0, 12, 0, 2)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = nameText
        nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLbl.Font = Enum.Font.SourceSansBold
        nameLbl.TextSize = 15
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.Parent = itemFrame

        if descText ~= "" then
            local descLbl = Instance.new("TextLabel")
            descLbl.Size = UDim2.new(1, -45, 0, 16)
            descLbl.Position = UDim2.new(0, 12, 0, 20)
            descLbl.BackgroundTransparency = 1
            descLbl.Text = descText
            descLbl.TextColor3 = Color3.fromRGB(160, 200, 180)
            descLbl.Font = Enum.Font.SourceSans
            descLbl.TextSize = 11
            descLbl.TextXAlignment = Enum.TextXAlignment.Left
            descLbl.Parent = itemFrame
        end

        local toggleBtn = Instance.new("TextButton")
        toggleBtn.Size = UDim2.new(0, 36, 0, 20)
        toggleBtn.Position = UDim2.new(1, -40, 0, 4)
        toggleBtn.BackgroundColor3 = defaultState and Color3.fromRGB(45, 200, 80) or Color3.fromRGB(220, 220, 220)
        toggleBtn.Text = ""
        toggleBtn.Parent = itemFrame
        Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 3)

        local innerBox = Instance.new("Frame")
        innerBox.Size = UDim2.new(0, 14, 0, 16)
        innerBox.Position = defaultState and UDim2.new(1, -16, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        innerBox.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        innerBox.Parent = toggleBtn
        Instance.new("UICorner", innerBox).CornerRadius = UDim.new(0, 2)

        local state = defaultState
        toggleBtn.MouseButton1Click:Connect(function()
            playUiSound(SOUND_CLICK, 1)
            state = not state
            toggleBtn.BackgroundColor3 = state and Color3.fromRGB(45, 200, 80) or Color3.fromRGB(220, 220, 220)
            innerBox.Position = state and UDim2.new(1, -16, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
            if onToggle then onToggle(state) end
        end)
    end

    local function addActionItem(nameText, onClick)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 24)
        btn.BackgroundTransparency = 1
        btn.Text = "    ▶  " .. nameText
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.SourceSansBold
        btn.TextSize = 14
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = contentHolder

        btn.MouseButton1Click:Connect(function()
            playUiSound(SOUND_CLICK, 1)
            if onClick then onClick() end
        end)
    end

    builderFunc(addToggleItem, addActionItem)

    headBtn.MouseButton1Click:Connect(function()
        playUiSound(SOUND_CLICK, 1)
        isOpen = not isOpen
        headBtn.Text = (isOpen and "  ˅  " or "  >  ") .. titleText
        contentHolder.Visible = isOpen
        
        if isOpen then
            local totalHeight = contentLayout.AbsoluteContentSize.Y
            contentHolder.Size = UDim2.new(1, 0, 0, totalHeight)
            sectionFrame.Size = UDim2.new(1, 0, 0, totalHeight + 28)
        else
            sectionFrame.Size = UDim2.new(1, 0, 0, 26)
        end
        
        task.wait(0.05)
        CenterScroll.CanvasSize = UDim2.new(0, 0, 0, CenterLayout.AbsoluteContentSize.Y + 20)
    end)
end

local function clearCenter()
    for _, child in ipairs(CenterScroll:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end
end


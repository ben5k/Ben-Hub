local function sendMessageNow()
    if ChatInput.Text ~= "" then
        local msg = ChatInput.Text
        ChatInput.Text = ""
        pcall(function()
            customRequest({
                Url = FIREBASE_CHAT_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({
                    sender = LocalPlayer.DisplayName ~= "" and LocalPlayer.DisplayName or LocalPlayer.Name,
                    userId = LocalPlayer.UserId,
                    text = msg,
                    time = os.time()
                })
            })
        end)
    end
end


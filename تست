local currentAccentColor = Color3.fromRGB(150, 40, 255)
local currentHeaderColor = Color3.fromRGB(110, 25, 200)
local selectedBgIndex = 0

local registeredWingStrokes = {}
local registeredOptionStrokes = {}

local function saveCurrentConfig()
    if writefile then
        local cfg = {
            accentR = currentAccentColor.R, accentG = currentAccentColor.G, accentB = currentAccentColor.B,
            headR = currentHeaderColor.R, headG = currentHeaderColor.G, headB = currentHeaderColor.B,
            bgIndex = selectedBgIndex,
            shake = enableShakeEffect
        }
        pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(cfg)) end)
    end
end

local function updateThemeColors(accent, headerCol, skipSave)
    currentAccentColor = accent
    currentHeaderColor = headerCol
    centerStroke.Color = accent
    Header.BackgroundColor3 = headerCol
    floatStroke.Color = accent
    chatStroke.Color = accent

    -- مزامنة أزرار الشات بالكامل مع الثيم
    ChatHeaderBtn1.BackgroundColor3 = accent
    ChatHeaderBtn2.BackgroundColor3 = accent
    SendBtn.BackgroundColor3 = accent

    for _, stroke in ipairs(registeredWingStrokes) do
        if stroke and stroke.Parent then stroke.Color = accent end
    end
    for _, stroke in ipairs(registeredOptionStrokes) do
        if stroke and stroke.Parent then stroke.Color = accent end
    end

    if not skipSave then saveCurrentConfig() end
end

local function applyBackgroundByIndex(idx, skipSave)
    selectedBgIndex = idx
    if idx > 0 and wallUrls[idx] then
        BgImage.Image = wallUrls[idx]
        BgImage.Visible = true
        CenterBox.BackgroundTransparency = 0.85
        
        ChatBgImage.Image = wallUrls[idx]
        ChatBgImage.Visible = true
        ChatWin.BackgroundTransparency = 0.85
    else
        BgImage.Visible = false
        CenterBox.BackgroundTransparency = 0
        ChatBgImage.Visible = false
        ChatWin.BackgroundTransparency = 0
    end
    if not skipSave then saveCurrentConfig() end
end

local function loadSavedConfig()
    if readfile and isfile and isfile(CONFIG_FILE) then
        pcall(function()
            local data = safeDecode(readfile(CONFIG_FILE))
            if data then
                if data.accentR then
                    updateThemeColors(Color3.new(data.accentR, data.accentG, data.accentB), Color3.new(data.headR, data.headG, data.headB), true)
                end
                if data.bgIndex then
                    applyBackgroundByIndex(data.bgIndex, true)
                end
                if data.shake ~= nil then enableShakeEffect = data.shake end
            end
        end)
    end
end

---------------------------------------------------------
-- أنيميشن الاهتزاز والضغط المطول
---------------------------------------------------------
local function addInteractiveAnimation(guiObject)
    local originalPos = guiObject.Position
    local isHolding = false

    guiObject.MouseEnter:Connect(function()
        if enableShakeEffect then
            originalPos = guiObject.Position
            TweenService:Create(guiObject, TweenInfo.new(0.05, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 3, true), {
                Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset + 3, originalPos.Y.Scale, originalPos.Y.Offset)
            }):Play()
        end
    end)

    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isHolding = true
            task.spawn(function()
                local t = 0
                while isHolding and enableShakeEffect do
                    t = t + 0.1
                    local offsetX = math.sin(t * 20) * 3
                    guiObject.Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset + offsetX, originalPos.Y.Scale, originalPos.Y.Offset)
                    task.wait(0.02)
                end
                guiObject.Position = originalPos
            end)
        end
    end)

    guiObject.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isHolding = false
            guiObject.Position = originalPos
        end
    end)
end


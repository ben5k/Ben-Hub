-- تصميم الأزرار والمفاتيح (Toggles 🟩 / ⬜) بالوسط مثل الصورة
local function addToggleItem(text, defaultState, onToggle)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -4, 0, 28)
    frame.BackgroundTransparency = 1
    frame.Parent = CenterScroll

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -45, 1, 0)
    lbl.Position = UDim2.new(0, 4, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.SourceSansBold
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 34, 0, 18)
    toggleBtn.Position = UDim2.new(1, -38, 0.5, -9)
    toggleBtn.BackgroundColor3 = defaultState and Color3.fromRGB(45, 200, 80) or Color3.fromRGB(220, 220, 220)
    toggleBtn.Text = ""
    toggleBtn.Parent = frame
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 3)

    local innerBox = Instance.new("Frame")
    innerBox.Size = UDim2.new(0, 12, 0, 14)
    innerBox.Position = defaultState and UDim2.new(1, -14, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    innerBox.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    innerBox.Parent = toggleBtn
    Instance.new("UICorner", innerBox).CornerRadius = UDim.new(0, 2)

    local state = defaultState
    toggleBtn.MouseButton1Click:Connect(function()
        playUiSound(SOUND_CLICK, 1)
        state = not state
        toggleBtn.BackgroundColor3 = state and Color3.fromRGB(45, 200, 80) or Color3.fromRGB(220, 220, 220)
        innerBox.Position = state and UDim2.new(1, -14, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        if onToggle then onToggle(state) end
    end)
    return frame
end


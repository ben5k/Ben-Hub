local function actionButton(parent, text, callback, width)
    local btn = make("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.new(0, width or 112, 0, 32),
        BackgroundColor3 = red,
        BorderSizePixel = 0,
        Font = Enum.Font.GothamBold,
        Text = text,
        TextColor3 = white,
        TextSize = 14,
        AutoButtonColor = true
    }, parent)
    corner(btn, 3)
    gradient(btn, Color3.fromRGB(255, 102, 78), redDark)
    stroke(btn, Color3.fromRGB(92, 30, 24), 1)

    btn.MouseButton1Click:Connect(function()
        if callback then callback() end
    end)
    return btn
end

local function notify(text)
    local oldNotice = gui:FindFirstChild("Notice")
    if oldNotice then oldNotice:Destroy() end

    local box = make("TextLabel", {
        Name = "Notice",
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, -25),
        Size = UDim2.new(0, 300, 0, 38),
        BackgroundColor3 = Color3.fromRGB(25, 25, 25),
        BackgroundTransparency = 0.05,
        Text = text,
        TextColor3 = white,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        BorderSizePixel = 0,
        ZIndex = 20
    }, gui)
    corner(box, 5)
    stroke(box, red, 1)

    task.delay(2, function()
        if box.Parent then box:Destroy() end
    end)
end


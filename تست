-- ====== تبويب: السيرفر ======
local serverPage = createTab("السيرفر")

local hopMode = "أقل لاعبين"
addDropdown(serverPage, "وضع تبديل السيرفر", { "أقل لاعبين", "أكثر لاعبين", "عشوائي" }, "أقل لاعبين", function(v)
    hopMode = v
end)

local function getServers()
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)
    local ok, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if ok and res and res.data then
        return res.data
    end
    return nil
end

addButton(serverPage, "تبديل السيرفر", "تبديل", function()
    notify("جاري البحث عن سيرفر...")
    local servers = getServers()
    if not servers then
        notify("فشل جلب السيرفرات")
        return
    end

    local list = {}
    for _, s in ipairs(servers) do
        if s.id ~= game.JobId and s.playing < s.maxPlayers then
            table.insert(list, s)
        end
    end
    if #list == 0 then
        notify("ما لقيت سيرفر مناسب")
        return
    end

    table.sort(list, function(a, b) return a.playing < b.playing end)
    local pick
    if hopMode == "أقل لاعبين" then
        pick = list[1]
    elseif hopMode == "أكثر لاعبين" then
        pick = list[#list]
    else
        pick = list[math.random(1, #list)]
    end

    TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, LocalPlayer)
end)


local guiParent = player:WaitForChild("PlayerGui")

local old = guiParent:FindFirstChild("ChilliArabicStatic")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "ChilliArabicStatic"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 999
gui.Parent = guiParent

local function create(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function outline(obj, color, thickness)
    create("UIStroke", {
        Color = color,
        Thickness = thickness or 1
    }, obj)
end

local function label(parent, text, size, pos, fontSize, align)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Size = size,
        Position = pos,
        Text = text,
        TextColor3 = Color3.fromRGB(245,245,245),
        Font = Enum.Font.GothamBold,
        TextSize = fontSize or 16,
        TextXAlignment = align or Enum.TextXAlignment.Right,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true
    }, parent)
end


local function playUiSound(soundId, pitch, volume)
    task.spawn(function()
        pcall(function()
            local snd = Instance.new("Sound")
            snd.SoundId = soundId
            snd.Volume = volume or 0.25
            snd.Pitch = pitch or 1
            snd.Parent = SoundService
            if not snd.IsLoaded then snd.Loaded:Wait() end
            snd:Play()
            snd.Ended:Connect(function() snd:Destroy() end)
        end)
    end)
end

local function playMusic(id)
    if currentMusicTrack then currentMusicTrack:Destroy() end
    currentMusicTrack = Instance.new("Sound")
    currentMusicTrack.SoundId = "rbxassetid://" .. tostring(id)
    currentMusicTrack.Volume = 0.5
    currentMusicTrack.Looped = true
    currentMusicTrack.Parent = SoundService
    currentMusicTrack:Play()
end

local function stopMusic()
    if currentMusicTrack then
        currentMusicTrack:Stop()
        currentMusicTrack:Destroy()
        currentMusicTrack = nil
    end
end


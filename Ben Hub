local lastPlayedAlertTick = 0
task.spawn(function()
    while true do
        pcall(function()
            local currentTime = os.time()
            local tbl = os.date("!*t", currentTime)
            local currentHourInZone = (tbl.hour + 3) % 24
            local wday = tbl.wday
            
            local daysToAdd = (7 - wday + 7) % 7
            if daysToAdd == 0 and (currentHourInZone >= 18) then daysToAdd = 7 end
            
            local targetSecondsToday = 18 * 3600
            local currentSecondsToday = (currentHourInZone * 3600) + (tbl.min * 60) + tbl.sec
            
            local secondsRemaining = 0
            if daysToAdd > 0 then
                secondsRemaining = ((daysToAdd - 1) * 86400) + (86400 - currentSecondsToday) + targetSecondsToday
            else
                if currentSecondsToday <= targetSecondsToday then
                    secondsRemaining = targetSecondsToday - currentSecondsToday
                else
                    secondsRemaining = 7 * 86400 - (currentSecondsToday - targetSecondsToday)
                end
            end

            local days = math.floor(secondsRemaining / 86400)
            local hours = math.floor((secondsRemaining % 86400) / 3600)
            local mins = math.floor((secondsRemaining % 3600) / 60)
            local secs = secondsRemaining % 60

            local timeStr = string.format("%d يوم : %02d س : %02d د : %02d ث", days, hours, mins, secs)
            CountdownMainLbl.Text = "⏳ الوقت باقي للحدث: " .. timeStr

            local isSaturday = (wday == 7)
            local warningPrefix = isSaturday and "🚨 [تنبيه هام: اليوم موعد حدث الأدمن!] - " or "👑 [اقترب موعد السبت] - "
            FloatingFrame.BackgroundColor3 = isSaturday and Color3.fromRGB(160, 35, 45) or Color3.fromRGB(15, 15, 22)
            FloatingLbl.Text = warningPrefix .. timeStr

            if secondsRemaining <= 5 and (tick() - lastPlayedAlertTick > 10) then
                lastPlayedAlertTick = tick()
                pcall(function() SoundService:PlayLocalSound(Instance.new("Sound", SoundService)) end)
            end
        end)
        task.wait(1)
    end
end)


local tabButtons = {}
local function createTabButton(text, iconId, targetTab)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 27)
    btn.BackgroundColor3 = (targetTab == HomeTab) and CUSTOM_ORANGE or Color3.fromRGB(22, 22, 28)
    btn.Text = iconId .. "  " .. text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 10.5
    btn.ZIndex = 4
    btn.Parent = ButtonsHolder

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    table.insert(tabButtons, {button = btn, tab = targetTab})

    btn.MouseButton1Click:Connect(function()
        playUiSound(SOUND_CLICK, 1)
        for _, t in ipairs(tabButtons) do
            t.button.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
            if t.tab then t.tab.Visible = false end
        end
        btn.BackgroundColor3 = CUSTOM_ORANGE
        if targetTab then targetTab.Visible = true end
    end)
    return btn
end


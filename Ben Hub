local function openMapScripts(mapInfo)
    for _, child in ipairs(ScriptsScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for _, sc in ipairs(mapInfo.scripts) do
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, -6, 0, 54)
        card.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
        card.Parent = ScriptsScroll
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(0.65, 0, 0, 20)
        title.Position = UDim2.new(0, 8, 0, 4)
        title.BackgroundTransparency = 1
        title.Text = "⚡ " .. sc.title
        title.TextColor3 = Color3.fromRGB(255, 215, 0)
        title.Font = Enum.Font.SourceSansBold
        title.TextSize = 11
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = card

        local keyBadge = Instance.new("TextLabel")
        keyBadge.Size = UDim2.new(0.65, 0, 0, 18)
        keyBadge.Position = UDim2.new(0, 8, 0, 26)
        keyBadge.BackgroundTransparency = 1
        keyBadge.Text = (sc.requiresKey == "نعم") and "🔑 يحتاج مفتاح" or "🟢 بدون مفتاح"
        keyBadge.TextColor3 = (sc.requiresKey == "نعم") and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(100, 255, 100)
        keyBadge.Font = Enum.Font.SourceSans
        keyBadge.TextSize = 9.5
        keyBadge.TextXAlignment = Enum.TextXAlignment.Left
        keyBadge.Parent = card

        local runBtn = Instance.new("TextButton")
        runBtn.Size = UDim2.new(0.28, 0, 0, 30)
        runBtn.Position = UDim2.new(0.7, 0, 0.5, -15)
        runBtn.BackgroundColor3 = Color3.fromRGB(180, 25, 35)
        runBtn.Text = "▶️ تشغيل"
        runBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        runBtn.Font = Enum.Font.SourceSansBold
        runBtn.TextSize = 10.5
        runBtn.Parent = card
        Instance.new("UICorner", runBtn).CornerRadius = UDim.new(0, 5)

        runBtn.MouseButton1Click:Connect(function()
            local success, err = pcall(function()
                local func, loadErr = loadstring(sc.code)
                if func then func() else error(loadErr) end
            end)
            runBtn.Text = success and "✅ تم التشغيل" or "❌ فشل التشغيل"
            task.wait(1.5)
            runBtn.Text = "▶️ تشغيل"
        end)
    end
    ScriptsScroll.CanvasSize = UDim2.new(0, 0, 0, ScriptsLayout.AbsoluteContentSize.Y + 10)
    MapsScroll.Visible = false
    ScriptDetailFrame.Visible = true
end

local function renderMapCards(filterText)
    for _, child in ipairs(MapsScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for _, map in ipairs(mapDataList) do
        if filterText == "" or string.find(string.lower(map.name), string.lower(filterText)) then
            local card = Instance.new("Frame")
            card.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
            card.ClipsDescendants = true
            card.Parent = MapsScroll
            Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)

            local mapImg = Instance.new("ImageLabel")
            mapImg.Size = UDim2.new(1, 0, 0, 60)
            mapImg.Image = map.image
            mapImg.ScaleType = Enum.ScaleType.Crop
            mapImg.Parent = card
            Instance.new("UICorner", mapImg).CornerRadius = UDim.new(0, 8)

            local title = Instance.new("TextLabel")
            title.Size = UDim2.new(1, -8, 0, 18)
            title.Position = UDim2.new(0, 4, 0, 62)
            title.BackgroundTransparency = 1
            title.Text = map.name
            title.TextColor3 = Color3.fromRGB(255, 255, 255)
            title.Font = Enum.Font.SourceSansBold
            title.TextSize = 10.5
            title.TextXAlignment = Enum.TextXAlignment.Left
            title.Parent = card

            local viewBtn = Instance.new("TextButton")
            viewBtn.Size = UDim2.new(1, -8, 0, 22)
            viewBtn.Position = UDim2.new(0, 4, 0, 82)
            viewBtn.BackgroundColor3 = Color3.fromRGB(180, 25, 35)
            viewBtn.Text = "عرض السكربتات ▶"
            viewBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            viewBtn.Font = Enum.Font.SourceSansBold
            viewBtn.TextSize = 9.5
            viewBtn.Parent = card
            Instance.new("UICorner", viewBtn).CornerRadius = UDim.new(0, 4)

            viewBtn.MouseButton1Click:Connect(function() openMapScripts(map) end)
        end
    end
    MapsScroll.CanvasSize = UDim2.new(0, 0, 0, MapsGrid.AbsoluteContentSize.Y + 10)
end

renderMapCards("")
MapSearchBox:GetPropertyChangedSignal("Text"):Connect(function() renderMapCards(MapSearchBox.Text) end)


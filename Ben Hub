-- فحص استقبال البث المباشر باستمرار لجميع مستخدمي السكربت
local lastReceivedBroadcastTime = 0

task.spawn(function()
    while true do
        pcall(function()
            local res = customRequest({Url = FIREBASE_BROADCAST_URL, Method = "GET"})
            if res and res.StatusCode == 200 and res.Body ~= "" and res.Body ~= "null" then
                local data = HttpService:JSONEncode and HttpService:JSONDecode(res.Body)
                if data and data.text and data.time then
                    if data.time > lastReceivedBroadcastTime and (os.time() - data.time < 15) then
                        lastReceivedBroadcastTime = data.time
                        triggerBroadcastAlert(data.text)
                    end
                end
            end
        end)
        task.wait(2)
    end
end)


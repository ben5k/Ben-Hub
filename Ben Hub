local function updateActiveUsersList()
    pcall(function()
        local res = customRequest({Url = FIREBASE_PRESENCE_URL .. ".json", Method = "GET"})
        if res and res.StatusCode == 200 then
            local data = safeDecode(res.Body)
            if data then
                for _, child in ipairs(UsersScroll:GetChildren()) do
                    if child:IsA("Frame") then child:Destroy() end
                end

                local count = 0
                local now = os.time()

                for _, usr in pairs(data) do
                    if type(usr) == "table" and usr.time and (now - usr.time < 90) then
                        count = count + 1

                        local uCard = Instance.new("Frame")
                        uCard.Size = UDim2.new(1, -6, 0, 42)
                        uCard.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
                        uCard.ZIndex = 1012
                        uCard.Parent = UsersScroll
                        Instance.new("UICorner", uCard).CornerRadius = UDim.new(0, 6)

                        local uLbl = Instance.new("TextLabel")
                        uLbl.Size = UDim2.new(1, -120, 1, 0)
                        uLbl.Position = UDim2.new(0, 42, 0, 0)
                        uLbl.BackgroundTransparency = 1
                        uLbl.Text = usr.displayName or usr.name or "مستخدم"
                        uLbl.TextColor3 = CUSTOM_ORANGE
                        uLbl.Font = Enum.Font.SourceSansBold
                        uLbl.TextSize = 12
                        uLbl.TextXAlignment = Enum.TextXAlignment.Left
                        uLbl.ZIndex = 1013
                        uLbl.Parent = uCard
                    end
                end

                ActiveCountLbl.Text = "🟢 المتواجدون الآن: " .. tostring(count)
                UsersScroll.CanvasSize = UDim2.new(0, 0, 0, UsersLayout.AbsoluteContentSize.Y + 10)
            end
        end
    end)
end


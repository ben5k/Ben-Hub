end

SendChatBtn.MouseButton1Click:Connect(function()
    local text = ChatInputBox.Text
    if text ~= "" and text ~= " " then
        if filterBadContent(text) then return end
        local senderDisplayName = LocalPlayer.DisplayName ~= "" and LocalPlayer.DisplayName or LocalPlayer.Name
        local data = {
            sender = senderDisplayName,
            userId = tostring(LocalPlayer.UserId),
            msg = text,
            timestamp = os.time()
        }
        customRequest({
            Url = FIREBASE_CHAT_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(data)
        })
        ChatInputBox.Text = ""
    end
end)

task.spawn(function()
    while true do
        pcall(function()
            local res = customRequest({Url = FIREBASE_CHAT_URL, Method = "GET"})
            if res and res.Body and res.Body ~= "null" and res.Body ~= "" then
                local msgs = HttpService:JSONDecode(res.Body)
                if msgs then
                    local list = {}
                    for k, m in pairs(msgs) do
                        if type(m) == "table" and not loadedMsgKeys[k] then
                            m.key = k
                            table.insert(list, m)
                        end
                    end
                    table.sort(list, function(a, b)
                        return (a.timestamp or 0) < (b.timestamp or 0)
                    end)
                    for _, m in ipairs(list) do
                        loadedMsgKeys[m.key] = true
                        addChatMessage(m.sender or "مجهول", m.msg or "", m.timestamp, m.userId)
                    end
                end
            end
        end)
        task.wait(2)
    end
end)


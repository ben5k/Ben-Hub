local lastPlayedAlertTime = 0

task.spawn(function()
    while true do
        local currentTime = os.time()
        local dateTable = os.date("*t", currentTime)
        local currentWeekday = dateTable.wday
        local targetSecondsToday = 18 * 3600
        local currentSecondsToday = (dateTable.hour * 3600) + (dateTable.min * 60) + dateTable.sec

        local diffSeconds = 0
        if currentWeekday == 7 then
            if currentSecondsToday < targetSecondsToday then
                diffSeconds = targetSecondsToday - currentSecondsToday
            else
                diffSeconds = (86400 - currentSecondsToday) + targetSecondsToday + (6 * 86400)
            end
        else
            local daysUntilSaturday = (7 - currentWeekday) % 7
            if daysUntilSaturday == 0 then daysUntilSaturday = 7 end
            diffSeconds = (86400 - currentSecondsToday) + targetSecondsToday + ((daysUntilSaturday - 1) * 86400)
        end

        local hours = math.floor(diffSeconds / 3600)
        local mins = math.floor((diffSeconds % 3600) / 60)
        local secs = diffSeconds % 60

        local timeStr = string.format("%02d:%02d:%02d", hours, mins, secs)
        TimerCountdownLbl.Text = timeStr
        WidgetText.Text = timeStr

        if currentWeekday == 7 and hours < 2 then
            WarnLabel.Visible = true
            if diffSeconds <= 0 and (currentTime - lastPlayedAlertTime > 60) then
                lastPlayedAlertTime = currentTime
                pcall(function()
                    local sound = Instance.new("Sound")
                    sound.SoundId = "rbxassetid://9061361426"
                    sound.Volume = 1
                    sound.Parent = SoundService
                    sound:Play()
                    task.delay(3, function() sound:Destroy() end)
                end)
            end
        else
            WarnLabel.Visible = false
        end

        task.wait(1)
    end
end)


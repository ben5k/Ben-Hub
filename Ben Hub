-- دورة المزامنة والريست العالمي كل 30 دقيقة
task.spawn(function()
    local INTERVAL = 1800
    local lastCycle = math.floor(os.time() / INTERVAL)
    while true do
        local now = os.time()
        local currentCycle = math.floor(now / INTERVAL)
        local remaining = INTERVAL - (now % INTERVAL)
        local mins = math.floor(remaining / 60)
        local secs = remaining % 60

        if ChatTimerLbl then
            ChatTimerLbl.Text = string.format("⏱️ %02d:%02d", mins, secs)
        end

        if currentCycle ~= lastCycle then
            lastCycle = currentCycle
            renderedMsgs = {}
            for _, child in ipairs(ChatScroll:GetChildren()) do
                if child:IsA("Frame") then child:Destroy() end
            end
            addChatMessage("sys_reset", 0, "النظام", "🔄 تم إعادة تصفير الشات لمرور 30 دقيقة.")
        end

        pcall(function()
            local res = customRequest({Url = FIREBASE_CHAT_URL, Method = "GET"})
            if res and res.StatusCode == 200 and res.Body ~= "" then
                local data = HttpService:JSONDecode(res.Body)
                if data then
                    for key, msg in pairs(data) do
                        if msg.time and math.floor(msg.time / INTERVAL) == currentCycle then
                            addChatMessage(key, msg.userId or 0, msg.sender or "مجهول", msg.text or "")
                        end
                    end
                end
            end
        end)

        task.wait(2)
    end
end)


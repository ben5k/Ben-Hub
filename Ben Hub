local ToggleAfkBtn = createSettingOptionBtn("وضع AFK وحفظ الموقع: معطل", "💤", Color3.fromRGB(120, 40, 40))

ToggleAfkBtn.MouseButton1Click:Connect(function()
    afkEnabled = not afkEnabled
    if afkEnabled then
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            afkSavedCFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
        end
        ToggleAfkBtn.Text = "💤   وضع AFK وحفظ الموقع: مفعل"
        ToggleAfkBtn.BackgroundColor3 = Color3.fromRGB(35, 120, 55)
    else
        afkSavedCFrame = nil
        ToggleAfkBtn.Text = "💤   وضع AFK وحفظ الموقع: معطل"
        ToggleAfkBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
    end
end)

task.spawn(function()
    while true do
        task.wait(300)
        if afkEnabled and afkSavedCFrame and LocalPlayer.Character then
            local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
            if root and hum then
                hum.Jump = true
                root.Velocity = Vector3.new(0, 35, 0)
                task.wait(1.5)
                root.CFrame = afkSavedCFrame
            end
        end
    end
end)


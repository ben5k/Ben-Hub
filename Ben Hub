local BroadcastGui = Instance.new("ScreenGui")
BroadcastGui.Name = "BenAdminBroadcastGui"
BroadcastGui.ResetOnSpawn = false
BroadcastGui.DisplayOrder = 999999
BroadcastGui.Parent = parent

local function showBroadcastPopup(senderName, senderUserId, messageText, eggType)
    if BroadcastGui:FindFirstChild("ActivePopup") then
        BroadcastGui.ActivePopup:Destroy()
    end

    local popFrame = Instance.new("Frame")
    popFrame.Name = "ActivePopup"
    popFrame.Size = UDim2.new(0, 440, 0, 75)
    popFrame.Position = UDim2.new(0.5, -220, 0, -90)
    
    local bgColor = Color3.fromRGB(12, 12, 18)
    local strokeColor = CUSTOM_ORANGE
    local titleHex = "#FF7725"

    if eggType == "Divine" then
        bgColor = Color3.fromRGB(35, 30, 10)
        strokeColor = Color3.fromRGB(255, 215, 0)
        titleHex = "#FFD700"
        playUiSound(divineSoundAsset, 1)
    elseif eggType == "Eternal" then
        bgColor = Color3.fromRGB(25, 10, 35)
        strokeColor = Color3.fromRGB(170, 0, 255)
        titleHex = "#AA00FF"
        playUiSound(eternalSoundAsset, 1)
    elseif eggType == "Secret" then
        bgColor = Color3.fromRGB(15, 15, 15)
        strokeColor = Color3.fromRGB(100, 100, 100)
        titleHex = "#AAAAAA"
        playUiSound(secretSoundAsset, 1)
    end

    popFrame.BackgroundColor3 = bgColor
    popFrame.BackgroundTransparency = 0.15
    popFrame.Parent = BroadcastGui

    Instance.new("UICorner", popFrame).CornerRadius = UDim.new(0, 12)
    local popStroke = Instance.new("UIStroke")
    popStroke.Color = strokeColor
    popStroke.Thickness = 2.2
    popStroke.Parent = popFrame

    local textLbl = Instance.new("TextLabel")
    textLbl.Size = UDim2.new(1, -20, 1, 0)
    textLbl.Position = UDim2.new(0, 10, 0, 0)
    textLbl.BackgroundTransparency = 1
    textLbl.Text = string.format("<font color=\"%s\" size=\"20\"><b>%s</b></font> : <font size=\"17\"><b>%s</b></font>", titleHex, senderName, messageText)
    textLbl.RichText = true
    textLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLbl.Font = Enum.Font.SourceSansBold
    textLbl.TextWrapped = true
    textLbl.TextXAlignment = Enum.TextXAlignment.Center
    textLbl.Parent = popFrame

    TweenService:Create(popFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -220, 0, 15)}):Play()

    task.delay(8, function()
        if popFrame and popFrame.Parent then
            TweenService:Create(popFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(0.5, -220, 0, -100)}):Play()
            task.wait(0.3)
            if popFrame then popFrame:Destroy() end
        end
    end)
end

local processedBroadcasts = {}
task.spawn(function()
    while true do
        pcall(function()
            local res = customRequest({Url = FIREBASE_BROADCAST_URL, Method = "GET"})
            if res and res.StatusCode == 200 and res.Body ~= "" and res.Body ~= "null" then
                local data = HttpService:JSONDecode(res.Body)
                if data then
                    for bKey, bData in pairs(data) do
                        if type(bData) == "table" and not processedBroadcasts[bKey] and (os.time() - (bData.time or 0) < 60) then
                            processedBroadcasts[bKey] = true
                            showBroadcastPopup(bData.senderName or "Ben", bData.senderUserId or LocalPlayer.UserId, bData.text or "", bData.eggType)
                        end
                    end
                end
            end
        end)
        task.wait(2)
    end
end)

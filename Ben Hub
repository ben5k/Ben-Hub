local ParticlesFrame = Instance.new("Frame")
ParticlesFrame.Size = UDim2.new(1, 0, 1, 0)
ParticlesFrame.BackgroundTransparency = 1
ParticlesFrame.ZIndex = 1
ParticlesFrame.Parent = Main

local activeStars = {}
local function clearParticles()
    for _, el in ipairs(activeStars) do if el.frame then el.frame:Destroy() end end
    activeStars = {}
end

local function spawnParticles()
    clearParticles()
    if not particlesEnabled then return end
    for i = 1, 22 do
        local star = Instance.new("Frame")
        local sz = math.random(2, 4)
        star.Size = UDim2.new(0, sz, 0, sz)
        star.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        star.BackgroundTransparency = math.random(3, 7) / 10
        star.BorderSizePixel = 0
        star.ZIndex = 1
        star.Position = UDim2.new(math.random(), 0, math.random(), 0)
        star.Parent = ParticlesFrame
        Instance.new("UICorner", star).CornerRadius = UDim.new(1, 0)
        table.insert(activeStars, {frame = star, speedY = -math.random(2, 8) / 10000})
    end
end
spawnParticles()

task.spawn(function()
    while Main and Main.Parent do
        if particlesEnabled then
            for _, el in ipairs(activeStars) do
                if el.frame and el.frame.Parent then
                    local posY = el.frame.Position.Y.Scale + el.speedY
                    if posY < -0.05 then posY = 1.05 end
                    el.frame.Position = UDim2.new(el.frame.Position.X.Scale, 0, posY, 0)
                end
            end
        end
        task.wait(0.03)
    end
end)


local lastSeenBroadcast = 0
task.spawn(function()
    while true do
        pcall(function()
            local res = customRequest({Url = FIREBASE_BROADCAST_URL .. ".json", Method = "GET"})
            if res and res.StatusCode == 200 and res.Body ~= "" and res.Body ~= "null" then
                local data = HttpService:JSONDecode(res.Body)
                if type(data) == "table" and data.time and data.time > lastSeenBroadcast then
                    lastSeenBroadcast = data.time
                    local target = data.target or "ALL"
                    if target == "ALL" or target == LocalPlayer.Name or tostring(target) == tostring(LocalPlayer.UserId) then
                        showAdminBroadcast(data.text or "")
                    end
                end
            end
        end)
        task.wait(3)
    end
end)


local lastSendTime = 0
local lastMessageContent = ""

local function checkBadContent(text)
    local lowerText = string.lower(text)
    local cleanText = string.gsub(lowerText, "[%s%_%-%*%#%@%!%.%,%d%~]", "")
    
    if string.find(lowerText, "http") or string.find(lowerText, "www.") or string.find(lowerText, "%.com") or string.find(lowerText, "%.gg") or string.find(lowerText, "%.net") or string.find(lowerText, "%.org") or string.find(lowerText, "%.me") then
        return true, "⚠️ ممنوع إرسال الروابط في الشات العام!"
    end

    for _, word in ipairs(badWords) do
        local cleanWord = string.gsub(string.lower(word), "%s+", "")
        if string.find(lowerText, word) or string.find(cleanText, cleanWord) then
            return true, "⚠️ تم حظر الرسالة لتواجد سب أو تعرض للأهل أو إيحاءات محظورة!"
        end
    end
    
    if string.find(cleanText, "^ا+ه+$") or string.find(cleanText, "^أ+ه+$") or string.find(cleanText, "^آ+ه+$") or string.find(cleanText, "^ا+ح+$") then
        return true, "⚠️ تم حظر الرسالة لتواجد إيحاءات وأهات محظورة!"
    end

    return false, ""
end


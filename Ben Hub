-- دالة تشغيل الصوت القوي والمضمون
local function playUiSound(soundId, pitch)
    if not soundEffectsEnabled then return end
    task.spawn(function()
        pcall(function()
            local snd = Instance.new("Sound")
            snd.SoundId = soundId
            snd.Volume = 10
            snd.Pitch = pitch or 1
            snd.Parent = SoundService
            
            if not snd.IsLoaded then
                snd.Loaded:Wait()
            end
            
            snd:Play()
            snd.Ended:Connect(function() snd:Destroy() end)
        end)
    end)
end


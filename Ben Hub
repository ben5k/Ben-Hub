local function customRequest(options)
    local req = request or http_request or (syn and syn.request) or (http and http.request)
    if req then return req(options) else return {StatusCode = 400, Body = ""} end
end

local function fetchAsset(url, fileName)
    if writefile and getcustomasset and readfile then
        local file = "BenHub_" .. fileName
        if not isfile(file) then
            pcall(function() writefile(file, game:HttpGet(url)) end)
        end
        if isfile(file) then return getcustomasset(file) end
    end
    return url
end


    if text ~= "" and text ~= " " then
        if tick() - lastSendTime < 2.5 then
            addChatMessage("sys_spam_" .. math.random(1000,9999), 0, "نظام الحماية", "⏳ فضلاً، انتظر قليلاً قبل إرسال رسالة أخرى.")
            return
        end

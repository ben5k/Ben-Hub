SendSuggestBtn.MouseButton1Click:Connect(function()
    playUiSound(SOUND_CLICK, 1)
    if SuggestTextBox.Text ~= "" then
        local data = {
            sender = LocalPlayer.DisplayName ~= "" and LocalPlayer.DisplayName or LocalPlayer.Name,
            suggestion = SuggestTextBox.Text,
            timestamp = os.time()
        }
        customRequest({
            Url = FIREBASE_SUGGEST_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(data)
        })
        SuggestTextBox.Text = ""
        SendSuggestBtn.Text = "✅ تم إرسال الاقتراح!"
        task.wait(2)
        SendSuggestBtn.Text = "📩 إرسال الاقتراح"
    end
end)

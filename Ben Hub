local isJailedLocally = false
local jailLoop = nil

local function applyJail(state)
    isJailedLocally = state
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
        if state then
            char.Humanoid.WalkSpeed = 0
            char.Humanoid.JumpPower = 0
            char.Humanoid.JumpHeight = 0
            if not jailLoop then
                local jailPos = char.HumanoidRootPart.CFrame
                jailLoop = RunService.RenderStepped:Connect(function()
                    if isJailedLocally and char and char:FindFirstChild("HumanoidRootPart") then
                        char.HumanoidRootPart.CFrame = jailPos
                        if char:FindFirstChild("Humanoid") then
                            char.Humanoid.WalkSpeed = 0
                            char.Humanoid.JumpPower = 0
                            char.Humanoid.JumpHeight = 0
                        end
                    end
                end)
            end
        else
            if jailLoop then jailLoop:Disconnect(); jailLoop = nil end
            char.Humanoid.WalkSpeed = 16
            char.Humanoid.JumpPower = 50
            char.Humanoid.JumpHeight = 7.2
        end
    end
end

local function moveCharacterRemote(dir)
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and not isJailedLocally then
        local hrp = char.HumanoidRootPart
        if dir == "FORWARD" then hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -5)
        elseif dir == "BACKWARD" then hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, 5)
        elseif dir == "LEFT" then hrp.CFrame = hrp.CFrame * CFrame.new(-5, 0, 0)
        elseif dir == "RIGHT" then hrp.CFrame = hrp.CFrame * CFrame.new(5, 0, 0)
        end
    end
end


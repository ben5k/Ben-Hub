local function playUiSound(soundId, pitch)
    if not soundEffectsEnabled then return end
    task.spawn(function()
        local snd = Instance.new("Sound")
        snd.SoundId = soundId
        snd.Volume = 0.8
        snd.Pitch = pitch or 1
        snd.Parent = SoundService
        snd:Play()
        snd.Ended:Connect(function() snd:Destroy() end)
    end)
end


task.spawn(function()
    while true do
        pcall(function()
            local res = customRequest({Url = FIREBASE_BROADCAST_URL, Method = "GET"})
            if res and res.StatusCode == 200 then
                local data = safeDecode(res.Body)
                if data then
                    for bKey, bData in pairs(data) do
                        if type(bData) == "table" and not processedBroadcasts[bKey] then
                            processedBroadcasts[bKey] = true
                            if bData.targetUserId == 0 or bData.targetUserId == LocalPlayer.UserId then
                                showBroadcastPopup(bData.senderName or "Ben", bData.senderUserId or LocalPlayer.UserId, bData.text or "", bData.eggType)
                            end
                        end
                    end
                end
            end
        end)
        task.wait(2)
    end
end)

-- 3. استقبال الشات
task.spawn(function()
    while true do
        pcall(function()
            local res = customRequest({Url = FIREBASE_CHAT_URL, Method = "GET"})
            if res and res.StatusCode == 200 then
                local data = safeDecode(res.Body)
                if data then
                    for key, msg in pairs(data) do
                        if type(msg) == "table" and msg.text then
                            addChatMessage(key, msg.userId or 0, msg.sender or "مجهول", msg.text or "")
                        end
                    end
                end
            end
        end)
        task.wait(2)
    end
end)

Main.Visible = true

local function openSubList(title, items, callback)
    SubListTitle.Text = title
    SubListModal.Visible = true
    for _, child in ipairs(SubListScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for _, itm in ipairs(items) do
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, -12, 0, 36)
        card.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
        card.ZIndex = 122
        card.Parent = SubListScroll
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 5)

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 1, 0)
        btn.BackgroundTransparency = 1
        btn.Text = tostring(itm)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.SourceSansBold
        btn.TextSize = 12
        btn.ZIndex = 123
        btn.Parent = card

        btn.MouseButton1Click:Connect(function()
            playUiSound(SOUND_CLICK, 1)
            callback(itm)
            SubListModal.Visible = false
        end)
    end
    SubListScroll.CanvasSize = UDim2.new(0, 0, 0, SubListLayout.AbsoluteContentSize.Y + 15)
end


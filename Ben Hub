local SendSuggestBtn = Instance.new("TextButton")
SendSuggestBtn.Size = UDim2.new(1, -10, 0, 30)
SendSuggestBtn.Position = UDim2.new(0, 0, 0, 215)
SendSuggestBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 60)
SendSuggestBtn.Text = "📩 إرسال الاقتراح"
SendSuggestBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SendSuggestBtn.Font = Enum.Font.SourceSansBold
SendSuggestBtn.TextSize = 11.5
SendSuggestBtn.Parent = SuggestTab
Instance.new("UICorner", SendSuggestBtn).CornerRadius = UDim.new(0, 6)

SendSuggestBtn.MouseButton1Click:Connect(function()
    if SuggestTextBox.Text ~= "" then
        local data = {
            sender = LocalPlayer.DisplayName ~= "" and LocalPlayer.DisplayName or LocalPlayer.Name,
            suggestion = SuggestTextBox.Text,
            timestamp = os.time()
        }
        customRequest({
            Url = FIREBASE_SUGGEST_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(data)
        })
        SuggestTextBox.Text = ""
        SendSuggestBtn.Text = "✅ تم إرسال الاقتراح!"
        task.wait(2)
        SendSuggestBtn.Text = "📩 إرسال الاقتراح"
    end
end)

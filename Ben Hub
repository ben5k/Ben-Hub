local function playCinematicScene(duration)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    
    if not rootPart or not humanoid then return end

    local origWalkSpeed = humanoid.WalkSpeed
    local origJumpPower = humanoid.JumpPower
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0

    local CineGui = Instance.new("ScreenGui")
    CineGui.Name = "BenCinematicGui"
    CineGui.IgnoreGuiInset = true
    CineGui.DisplayOrder = 9999999
    CineGui.Parent = parent

    local TopBar = Instance.new("Frame")
    TopBar.Size = UDim2.new(1, 0, 0, 0)
    TopBar.Position = UDim2.new(0, 0, 0, 0)
    TopBar.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    TopBar.BorderSizePixel = 0
    TopBar.Parent = CineGui

    local BottomBar = Instance.new("Frame")
    BottomBar.Size = UDim2.new(1, 0, 0, 0)
    BottomBar.Position = UDim2.new(0, 0, 1, 0)
    BottomBar.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    BottomBar.BorderSizePixel = 0
    BottomBar.Parent = CineGui

    TweenService:Create(TopBar, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0.12, 0)}):Play()
    TweenService:Create(BottomBar, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0.12, 0), Position = UDim2.new(0, 0, 0.88, 0)}):Play()

    local camera = Workspace.CurrentCamera
    local origCamType = camera.CameraType
    camera.CameraType = Enum.CameraType.Scriptable

    local targetEmoteId = 76480113479386
    local danceTrack = nil

    pcall(function()
        local desc = humanoid:FindFirstChildOfClass("HumanoidDescription") or Instance.new("HumanoidDescription", humanoid)
        local emotes = desc:GetEmotes()
        emotes["CineDance"] = {targetEmoteId}
        desc:SetEmotes(emotes)
        humanoid:PlayEmote("CineDance")
    end)

    pcall(function()
        local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. tostring(targetEmoteId)
        danceTrack = animator:LoadAnimation(anim)
        danceTrack.Priority = Enum.AnimationPriority.Action4
        danceTrack:Play()
    end)

    local sound = Instance.new("Sound")
    pcall(function()
        sound.SoundId = "rbxassetid://92948891633881"
        sound.Volume = 25
        sound.Parent = SoundService
        sound:Play()
    end)

    local startTime = tick()
    local connection
    connection = game:GetService("RunService").RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        if elapsed >= duration then
            connection:Disconnect()
        else
            local angle = elapsed * 0.55
            local camPos = rootPart.Position + Vector3.new(math.sin(angle) * 11, 2.5, math.cos(angle) * 11)
            camera.CFrame = CFrame.new(camPos, rootPart.Position + Vector3.new(0, 1.2, 0))
        end
    end)

    task.wait(duration)

    if danceTrack then pcall(function() danceTrack:Stop() end) end
    pcall(function() sound:Stop() sound:Destroy() end)

    TweenService:Create(TopBar, TweenInfo.new(0.6), {Size = UDim2.new(1, 0, 0, 0)}):Play()
    local bTween = TweenService:Create(BottomBar, TweenInfo.new(0.6), {Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 1, 0)})
    bTween:Play()

    bTween.Completed:Connect(function()
        CineGui:Destroy()
    end)

    camera.CameraType = origCamType
    if humanoid then
        humanoid.WalkSpeed = origWalkSpeed > 0 and origWalkSpeed or 16
        humanoid.JumpPower = origJumpPower > 0 and origJumpPower or 50
    end
end


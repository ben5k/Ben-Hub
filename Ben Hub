local function setupDeveloperTag(character, playerName)
    if playerName ~= "Dms921" then return end
    if not character or not character:FindFirstChild("Head") then return end
    local head = character.Head

    if head:FindFirstChild("BenDevTag") then return end

    local bill = Instance.new("BillboardGui")
    bill.Name = "BenDevTag"
    bill.Size = UDim2.new(0, 220, 0, 40)
    bill.StudsOffset = Vector3.new(0, 3.8, 0)
    bill.AlwaysOnTop = true
    bill.Adornee = head
    bill.Parent = head

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = "مطور Ben 👑"
    lbl.Font = Enum.Font.SourceSansBold
    lbl.TextSize = 16
    lbl.TextStrokeTransparency = 0.3
    lbl.Parent = bill

    task.spawn(function()
        while lbl and lbl.Parent do
            local t = tick() * 2
            lbl.TextColor3 = Color3.fromHSV((t % 5) / 5, 1, 1)
            task.wait(0.05)
        end
    end)
end


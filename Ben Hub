local function renderMapCards(filterText)
    for _, child in ipairs(MapsScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    for _, map in ipairs(mapDataList) do
        if filterText == "" or string.find(string.lower(map.name), string.lower(filterText)) then
            local card = Instance.new("Frame")
            card.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
            card.ClipsDescendants = true
            card.Parent = MapsScroll
            Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)

            local mapImg = Instance.new("ImageLabel")
            mapImg.Size = UDim2.new(1, 0, 0, 60)
            mapImg.Image = map.image
            mapImg.ScaleType = Enum.ScaleType.Crop
            mapImg.Parent = card
            Instance.new("UICorner", mapImg).CornerRadius = UDim.new(0, 8)

            local title = Instance.new("TextLabel")
            title.Size = UDim2.new(1, -8, 0, 18)
            title.Position = UDim2.new(0, 4, 0, 62)
            title.BackgroundTransparency = 1
            title.Text = map.name
            title.TextColor3 = Color3.fromRGB(255, 255, 255)
            title.Font = Enum.Font.SourceSansBold
            title.TextSize = 10.5
            title.TextXAlignment = Enum.TextXAlignment.Left
            title.Parent = card

            local viewBtn = Instance.new("TextButton")
            viewBtn.Size = UDim2.new(1, -8, 0, 22)
            viewBtn.Position = UDim2.new(0, 4, 0, 82)
            viewBtn.BackgroundColor3 = Color3.fromRGB(180, 25, 35)
            viewBtn.Text = "عرض السكربتات ▶"
            viewBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            viewBtn.Font = Enum.Font.SourceSansBold
            viewBtn.TextSize = 9.5
            viewBtn.Parent = card
            Instance.new("UICorner", viewBtn).CornerRadius = UDim.new(0, 4)

            viewBtn.MouseButton1Click:Connect(function() openMapScripts(map) end)
        end
    end
    MapsScroll.CanvasSize = UDim2.new(0, 0, 0, MapsGrid.AbsoluteContentSize.Y + 10)
end

renderMapCards("")
MapSearchBox:GetPropertyChangedSignal("Text"):Connect(function() renderMapCards(MapSearchBox.Text) end)


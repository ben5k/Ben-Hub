local badWords = {"كفر", "سب", "شتم", "قذف", "كس", "قحبة", "خرا", "حمار", "كلب", "زبي", "منيوك", "خول", "شرموط"}
local lastSendTime = 0
local lastMessageContent = ""

local function checkBadContent(text)
    local lowerText = string.lower(text)
    if string.find(lowerText, "http") or string.find(lowerText, "www.") or string.find(lowerText, "%.com") or string.find(lowerText, "%.gg") or string.find(lowerText, "%.net") or string.find(lowerText, "%.org") or string.find(lowerText, "%.me") then
        return true, "⚠️ ممنوع إرسال الروابط في الشات العام!"
    end
    for _, word in ipairs(badWords) do
        if string.find(lowerText, word) then
            return true, "⚠️ تم حظر الرسالة لتواجد ألفاظ بذيئة أو سب!"
        end
    end
    return false, ""
end

local renderedMsgs = {}

local function addChatMessage(msgId, userId, sender, msg)
    if renderedMsgs[msgId] then return end
    renderedMsgs[msgId] = true

    local msgFrame = Instance.new("Frame")
    msgFrame.Size = UDim2.new(1, 0, 0, 30)
    msgFrame.BackgroundTransparency = 1
    msgFrame.ZIndex = 1002
    msgFrame.Parent = ChatScroll

    if userId and userId ~= 0 then
        local userImg = Instance.new("ImageLabel")
        userImg.Size = UDim2.new(0, 26, 0, 26)
        userImg.Position = UDim2.new(0, 0, 0, 2)
        userImg.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        userImg.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(userId) .. "&w=150&h=150"
        userImg.ZIndex = 1003
        userImg.Parent = msgFrame
        Instance.new("UICorner", userImg).CornerRadius = UDim.new(1, 0)
    end

    local msgText = Instance.new("TextLabel")
    msgText.Size = UDim2.new(1, (userId and userId ~= 0) and -32 or 0, 1, 0)
    msgText.Position = UDim2.new(0, (userId and userId ~= 0) and 32 or 0, 0, 0)
    msgText.BackgroundTransparency = 1
    msgText.Text = "<b>" .. sender .. ":</b> " .. msg
    msgText.RichText = true
    msgText.TextColor3 = Color3.fromRGB(240, 240, 250)
    msgText.Font = Enum.Font.SourceSans
    msgText.TextSize = 12
    msgText.TextWrapped = true
    msgText.TextXAlignment = Enum.TextXAlignment.Left
    msgText.ZIndex = 1003
    msgText.Parent = msgFrame

    ChatScroll.CanvasSize = UDim2.new(0, 0, 0, ChatLayout.AbsoluteContentSize.Y + 12)
    ChatScroll.CanvasPosition = Vector2.new(0, ChatScroll.AbsoluteCanvasSize.Y)

    local targetPlayer = Players:FindFirstChild(sender)
    if targetPlayer and targetPlayer.Character then
        showFloatingBubble(targetPlayer.Character, msg)
    end
end


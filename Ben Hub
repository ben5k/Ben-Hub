    if text ~= "" and text ~= " " then
        if tick() - lastSendTime < 2.5 then
            addChatMessage("sys_spam_" .. math.random(1000,9999), 0, "نظام الحماية", "⏳ فضلاً، انتظر قليلاً قبل إرسال رسالة أخرى.")
            return
        end
        if text == lastMessageContent then
            addChatMessage("sys_repeat_" .. math.random(1000,9999), 0, "نظام الحماية", "⚠️ ممنوع تكرار نفس الرسالة تماماً!")
            return
        end

        local isBlocked, warningMsg = checkBadContent(text)
        if isBlocked then
            addChatMessage("sys_warn_" .. math.random(1000,9999), 0, "نظام الحماية", warningMsg)
            ChatInputBox.Text = ""
            return
        end

        lastSendTime = tick()
        lastMessageContent = text
        local senderName = LocalPlayer.DisplayName ~= "" and LocalPlayer.DisplayName or LocalPlayer.Name
        ChatInputBox.Text = ""

        pcall(function()
            customRequest({
                Url = FIREBASE_CHAT_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({
                    sender = senderName,
                    userId = LocalPlayer.UserId,
                    text = text,
                    time = os.time()
                })
            })
        end)
    end
end)


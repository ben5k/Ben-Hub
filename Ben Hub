local function showFloatingBubble(character, msgText)
    if not character or not character:FindFirstChild("Head") then return end
    local head = character.Head
    
    if head:FindFirstChild("BenChatBubble") then
        head.BenChatBubble:Destroy()
    end

    local bill = Instance.new("BillboardGui")
    bill.Name = "BenChatBubble"
    bill.Size = UDim2.new(0, 200, 0, 50)
    bill.StudsOffset = Vector3.new(0, 2.8, 0)
    bill.AlwaysOnTop = true
    bill.Adornee = head
    bill.Parent = head

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
    frame.BackgroundTransparency = 0.2
    frame.Parent = bill
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 215, 0)
    stroke.Thickness = 1.5
    stroke.Parent = frame

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 1, -6)
    lbl.Position = UDim2.new(0, 5, 0, 3)
    lbl.BackgroundTransparency = 1
    lbl.Text = msgText
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.SourceSansBold
    lbl.TextSize = 13
    lbl.TextWrapped = true
    lbl.Parent = frame

    task.delay(4, function()
        if bill and bill.Parent then bill:Destroy() end
    end)
end

